      },
      {
        "id": "dtype_object_string",
        "description": "Cast to object dtype",
        "constraints": "st.just('object')"
      },
      {
        "id": "dtype_incompatible",
        "description": "When conversion is impossible, a TypeError exception is raised",
        "constraints": "st.just('datetime64[ns]')"
      }
