{
  "metadata": {
    "library": "pandas",
    "version": "2.x / 3.x",
    "function": "DataFrame.reindex",
    "references": [
      "https://pandas.pydata.org/docs/reference/api/pandas.DataFrame.reindex.html"
    ]
  },
  "preconditions": {
    "self": {
      "type": "pandas.DataFrame",
      "partitions": [
        {
          "id": "df_int_monotonic",
          "description": "Integer-indexed, sorted, no NaNs",
          "type": "pandas.DataFrame",
          "constraints": {
            "index_type": "int",
            "index_sorted": true,
            "index_unique": true,
            "rows": {
              "min": 2,
              "max": 8
            },
            "cols": {
              "min": 1,
              "max": 4
            },
            "col_dtype": "float",
            "has_nan": false
          }
        },
        {
          "id": "df_str_unsorted",
          "description": "String-indexed, unsorted, no NaNs",
          "type": "pandas.DataFrame",
          "constraints": {
            "index_type": "str",
            "index_sorted": false,
            "index_unique": true,
            "rows": {
              "min": 2,
              "max": 6
            },
            "cols": {
              "min": 1,
              "max": 3
            },
            "col_dtype": "float",
            "has_nan": false
          }
        },
        {
          "id": "df_datetime_monotonic",
          "description": "DatetimeIndex, sorted, float columns",
          "type": "pandas.DataFrame",
          "constraints": {
            "index_type": "datetime",
            "index_sorted": true,
            "index_unique": true,
            "rows": {
              "min": 3,
              "max": 10
            },
            "cols": {
              "min": 1,
              "max": 3
            },
            "col_dtype": "float",
            "has_nan": false
          }
        },
        {
          "id": "df_with_nan",
          "description": "Integer-indexed, sorted, contains NaN values in data",
          "type": "pandas.DataFrame",
          "constraints": {
            "index_type": "int",
            "index_sorted": true,
            "index_unique": true,
            "rows": {
              "min": 3,
              "max": 8
            },
            "cols": {
              "min": 2,
              "max": 4
            },
            "col_dtype": "float",
            "has_nan": true
          }
        }
      ]
    },
    "params": {
      "labels": {
        "partitions": [
          {
            "id": "labels_none",
            "description": "Not provided — axis unchanged",
            "type": "None",
            "constraints": {},
            "constraint_tags": []
          },
          {
            "id": "labels_identical",
            "description": "Exactly the same as original index, same order",
            "type": "List[~index_type]",
            "constraints": {
              "relative": "identical"
            },
            "constraint_tags": []
          },
          {
            "id": "labels_subset",
            "description": "Strict subset of original index labels",
            "type": "List[~index_type]",
            "constraints": {
              "relative": "subset",
              "length": {
                "min": 1
              }
            },
            "constraint_tags": []
          },
          {
            "id": "labels_with_overlap",
            "description": "Mix of existing and new labels",
            "type": "List[~index_type]",
            "constraints": {
              "relative": "partial_overlap"
            },
            "constraint_tags": []
          },
          {
            "id": "labels_no_overlap",
            "description": "Entirely new labels, none in original index",
            "type": "List[~index_type]",
            "constraints": {
              "relative": "disjoint",
              "length": {
                "min": 1,
                "max": 4
              }
            },
            "constraint_tags": []
          },
          {
            "id": "labels_empty",
            "description": "Empty list — result should have zero rows",
            "type": "List[~index_type]",
            "constraints": {
              "length": {
                "min": 0,
                "max": 0
              }
            },
            "constraint_tags": []
          }
        ]
      },
      "columns": {
        "partitions": [
          {
            "id": "columns_none",
            "description": "Not provided — columns unchanged",
            "type": "None",
            "constraints": {},
            "constraint_tags": []
          },
          {
            "id": "columns_identical",
            "description": "Same as original columns",
            "type": "List[str]",
            "constraints": {
              "relative": "identical"
            },
            "constraint_tags": []
          },
          {
            "id": "columns_subset",
            "description": "Strict subset of original columns",
            "type": "List[str]",
            "constraints": {
              "relative": "subset",
              "length": {
                "min": 1
              }
            },
            "constraint_tags": []
          },
          {
            "id": "columns_partial_overlap",
            "description": "Mix of existing and new column names",
            "type": "List[str]",
            "constraints": {
              "relative": "partial_overlap"
            },
            "constraint_tags": []
          },
          {
            "id": "columns_no_overlap",
            "description": "All new column names, none in original",
            "type": "List[str]",
            "constraints": {
              "relative": "disjoint",
              "length": {
                "min": 1,
                "max": 3
              }
            },
            "constraint_tags": []
          }
        ]
      },
      "method": {
        "partitions": [
          {
            "id": "method_none",
            "description": "No fill method — NaN for missing labels",
            "type": "None",
            "constraints": {},
            "constraint_tags": []
          },
          {
            "id": "method_ffill",
            "description": "Forward fill from last valid observation",
            "type": "str",
            "constraints": {
              "literal": "ffill"
            },
            "constraint_tags": [
              "requires_monotonic_index",
              "excludes_fill_value"
            ]
          },
          {
            "id": "method_bfill",
            "description": "Backward fill from next valid observation",
            "type": "str",
            "constraints": {
              "literal": "bfill"
            },
            "constraint_tags": [
              "requires_monotonic_index",
              "excludes_fill_value"
            ]
          },
          {
            "id": "method_nearest",
            "description": "Fill from nearest valid observation",
            "type": "str",
            "constraints": {
              "literal": "nearest"
            },
            "constraint_tags": [
              "requires_monotonic_index",
              "excludes_fill_value"
            ]
          }
        ]
      },
      "fill_value": {
        "partitions": [
          {
            "id": "fill_value_default",
            "description": "Not provided — defaults to NaN",
            "type": "None",
            "constraints": {},
            "constraint_tags": []
          },
          {
            "id": "fill_numeric",
            "description": "Numeric fill value (e.g. 0 or -1)",
            "type": "int",
            "constraints": {
              "min": -10,
              "max": 10
            },
            "constraint_tags": [
              "excludes_method"
            ]
          },
          {
            "id": "fill_string",
            "description": "String fill value (e.g. 'missing')",
            "type": "str",
            "constraints": {
              "literal": "missing"
            },
            "constraint_tags": [
              "excludes_method"
            ]
          }
        ]
      },
      "limit": {
        "partitions": [
          {
            "id": "limit_none",
            "description": "Not provided — fill as many as needed",
            "type": "None",
            "constraints": {},
            "constraint_tags": []
          },
          {
            "id": "limit_one",
            "description": "Fill at most 1 consecutive gap",
            "type": "int",
            "constraints": {
              "min": 1,
              "max": 1
            },
            "constraint_tags": [
              "requires_method"
            ]
          },
          {
            "id": "limit_large",
            "description": "Fill up to a large number of consecutive gaps",
            "type": "int",
            "constraints": {
              "min": 5,
              "max": 20
            },
            "constraint_tags": [
              "requires_method"
            ]
          }
        ]
      },
      "tolerance": {
        "partitions": [
          {
            "id": "tolerance_none",
            "description": "Not provided — exact label matching only",
            "type": "None",
            "constraints": {},
            "constraint_tags": []
          },
          {
            "id": "tolerance_small",
            "description": "Small tolerance for inexact numeric matching",
            "type": "float",
            "constraints": {
              "min": 0.1,
              "max": 1.0
            },
            "constraint_tags": [
              "requires_numeric_or_datetime_index"
            ]
          }
        ]
      }
    },
    "compatibility_rules": [
      {
        "rule": "method != null requires index to be monotonic",
        "if_tags": [
          "requires_monotonic_index"
        ],
        "then_require_self": [
          "df_int_monotonic",
          "df_datetime_monotonic"
        ]
      },
      {
        "rule": "method and fill_value are mutually exclusive",
        "if_tags": [
          "excludes_fill_value"
        ],
        "then_exclude_params": [
          "fill_numeric",
          "fill_string"
        ]
      },
      {
        "rule": "limit only valid when method is set",
        "if_tags": [
          "requires_method"
        ],
        "then_require_params": [
          "method_ffill",
          "method_bfill",
          "method_nearest"
        ]
      },
      {
        "rule": "tolerance only valid for numeric or datetime index",
        "if_tags": [
          "requires_numeric_or_datetime_index"
        ],
        "then_require_self": [
          "df_int_monotonic",
          "df_datetime_monotonic"
        ]
      }
    ]
  },
  "postconditions": [
    {
      "id": "PC-01",
      "claim": "reindex always returns a DataFrame regardless of which parameters are used",
      "trigger": {},
      "expected_behavior": "isinstance(result, pd.DataFrame) == True",
      "confidence": "explicit"
    },
    {
      "id": "PC-02",
      "claim": "when labels are provided without method, new labels not in the original index produce rows where all cells are NaN",
      "trigger": {
        "labels": "labels_with_overlap | labels_no_overlap",
        "method": "method_none"
      },
      "expected_behavior": "for lbl in set(new_labels) - set(original_index): result.loc[lbl].isna().all() == True",
      "confidence": "explicit"
    },
    {
      "id": "PC-03",
      "claim": "labels that exist in both old and new index retain their original values exactly",
      "trigger": {
        "labels": "labels_with_overlap | labels_subset | labels_identical"
      },
      "expected_behavior": "result.loc[common_labels].equals(original_df.loc[common_labels]) == True",
      "confidence": "explicit"
    },
    {
      "id": "PC-04",
      "claim": "new column labels not in original columns produce NaN-filled columns when method=None",
      "trigger": {
        "columns": "columns_partial_overlap | columns_no_overlap",
        "method": "method_none"
      },
      "expected_behavior": "for col in set(new_columns) - set(original_columns): result[col].isna().all() == True",
      "confidence": "explicit"
    },
    {
      "id": "PC-05",
      "claim": "result index equals the new labels passed in, preserving order",
      "trigger": {
        "labels": "labels_with_overlap | labels_no_overlap | labels_identical | labels_subset | labels_empty"
      },
      "expected_behavior": "list(result.index) == list(new_labels)",
      "confidence": "explicit"
    },
    {
      "id": "PC-06",
      "claim": "fill_value replaces NaN for new labels not in original index when method=None",
      "trigger": {
        "labels": "labels_with_overlap | labels_no_overlap",
        "method": "method_none",
        "fill_value": "fill_numeric | fill_string"
      },
      "expected_behavior": "for lbl in set(new_labels) - set(original_index): (result.loc[lbl] == fill_value).all() == True",
      "confidence": "explicit"
    },
    {
      "id": "PC-07",
      "claim": "fill_value has no effect on labels that already exist in the original index",
      "trigger": {
        "labels": "labels_with_overlap",
        "fill_value": "fill_numeric | fill_string"
      },
      "expected_behavior": "result.loc[common_labels].equals(original_df.loc[common_labels]) == True",
      "confidence": "implicit"
    },
    {
      "id": "PC-08",
      "claim": "result has zero rows when labels is an empty list",
      "trigger": {
        "labels": "labels_empty"
      },
      "expected_behavior": "result.shape[0] == 0",
      "confidence": "explicit"
    },
    {
      "id": "PC-09",
      "claim": "result column count equals len(columns) when columns is provided",
      "trigger": {
        "columns": "columns_subset | columns_partial_overlap | columns_no_overlap | columns_identical"
      },
      "expected_behavior": "result.shape[1] == len(new_columns)",
      "confidence": "explicit"
    },
    {
      "id": "PC-10",
      "claim": "ffill/bfill does not introduce NaN beyond the first/last valid label when limit is not set",
      "trigger": {
        "labels": "labels_with_overlap | labels_no_overlap",
        "method": "method_ffill | method_bfill",
        "limit": "limit_none",
        "self": "df_int_monotonic | df_datetime_monotonic"
      },
      "expected_behavior": "result.isna().sum().sum() <= original_df.isna().sum().sum()",
      "confidence": "implicit"
    },
    {
      "id": "PC-11",
      "claim": "when limit=1, at most 1 consecutive gap is filled per column",
      "trigger": {
        "method": "method_ffill | method_bfill",
        "limit": "limit_one"
      },
      "expected_behavior": "no run of filled values in any column exceeds length 1",
      "confidence": "explicit"
    },
    {
      "id": "PC-12",
      "claim": "reindex with labels_identical and method_none returns a DataFrame equal to the original",
      "trigger": {
        "labels": "labels_identical",
        "method": "method_none"
      },
      "expected_behavior": "result.equals(original_df) == True",
      "confidence": "explicit"
    },
    {
      "id": "PC-13",
      "claim": "original DataFrame is never mutated by reindex",
      "trigger": {},
      "expected_behavior": "original_df.equals(snapshot_before_call) == True",
      "confidence": "explicit"
    },
    {
      "id": "PC-14",
      "claim": "existing column values are preserved for columns that appear in both old and new column list",
      "trigger": {
        "columns": "columns_subset | columns_partial_overlap | columns_identical"
      },
      "expected_behavior": "result[common_columns].equals(original_df[common_columns]) == True",
      "confidence": "explicit"
    }
  ]
}